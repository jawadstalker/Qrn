diff --git a/src/features/quran/plan/components/SurahPickerModal.tsx b/src/features/quran/plan/components/SurahPickerModal.tsx
new file mode 100644
index 0000000..0f4da11
--- /dev/null
+++ b/src/features/quran/plan/components/SurahPickerModal.tsx
@@ -0,0 +1,285 @@
+import React, { useEffect, useMemo, useState } from "react";
+import {
+  FlatList,
+  Modal,
+  Pressable,
+  StyleSheet,
+  Text,
+  TextInput,
+  View,
+  type ListRenderItemInfo,
+} from "react-native";
+import { Check, Search, X } from "lucide-react-native";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import { useDirection } from "@/core/i18n/useDirection";
+import { useLanguage } from "@/core/i18n/LanguageContext";
+import { formatNumber } from "@/core/i18n/format";
+import { useTheme } from "@/core/theme/ThemeContext";
+import { AppText } from "@/shared/components/ui/AppText";
+import { SURAHS, type SurahInfo } from "@/features/quran/data/surahs";
+import { fill } from "@/features/quran/utils/fill";
+
+interface SurahPickerModalProps {
+  visible: boolean;
+  /** Surah ids that are checked when the dialog opens. */
+  selected: readonly number[];
+  onConfirm: (ids: number[]) => void;
+  onClose: () => void;
+}
+
+export function SurahPickerModal({
+  visible,
+  selected,
+  onConfirm,
+  onClose,
+}: SurahPickerModalProps) {
+  const { colors } = useTheme();
+  const { t, language } = useLanguage();
+  const { row, textAlign, isRTL } = useDirection();
+  const insets = useSafeAreaInsets();
+  const [query, setQuery] = useState("");
+  const [checked, setChecked] = useState<Set<number>>(new Set(selected));
+  const number = (value: number) => formatNumber(value, language);
+
+  useEffect(() => {
+    if (visible) {
+      setChecked(new Set(selected));
+      setQuery("");
+    }
+    // Reset only when the dialog opens.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [visible]);
+
+  const data = useMemo(() => {
+    const normalized = query.trim().toLowerCase();
+
+    if (!normalized) {
+      return SURAHS;
+    }
+
+    return SURAHS.filter(
+      (surah) =>
+        surah.name.includes(normalized) ||
+        surah.transliteration.toLowerCase().includes(normalized) ||
+        String(surah.id) === normalized,
+    );
+  }, [query]);
+
+  const toggle = (id: number) =>
+    setChecked((current) => {
+      const next = new Set(current);
+
+      if (next.has(id)) {
+        next.delete(id);
+      } else {
+        next.add(id);
+      }
+
+      return next;
+    });
+
+  const confirm = () =>
+    onConfirm([...checked].sort((a, b) => a - b));
+
+  const renderItem = ({ item }: ListRenderItemInfo<SurahInfo>) => {
+    const isChecked = checked.has(item.id);
+
+    return (
+      <Pressable
+        accessibilityRole="checkbox"
+        accessibilityState={{ checked: isChecked }}
+        accessibilityLabel={`${item.name} ${item.transliteration}`}
+        onPress={() => toggle(item.id)}
+        style={[
+          styles.rowItem,
+          {
+            backgroundColor: isChecked ? colors.tintSoft : colors.surface,
+            flexDirection: row,
+          },
+        ]}
+      >
+        <View
+          style={[
+            styles.checkbox,
+            {
+              borderColor: colors.primary,
+              backgroundColor: isChecked ? colors.primary : "transparent",
+            },
+          ]}
+        >
+          {isChecked ? <Check size={16} color="#FFFFFF" strokeWidth={3} /> : null}
+        </View>
+        <View style={styles.rowText}>
+          <Text
+            allowFontScaling={false}
+            style={[styles.arabicName, { color: colors.text, textAlign }]}
+          >
+            {item.name}
+          </Text>
+          <AppText
+            variant="caption"
+            style={{ color: colors.textSecondary, textAlign }}
+          >
+            {`${item.transliteration} · ${number(item.verses)} ${t.quran_verses_word}`}
+          </AppText>
+        </View>
+        <AppText
+          variant="caption"
+          style={{ color: colors.textSecondary, fontWeight: "700" }}
+        >
+          {number(item.id)}
+        </AppText>
+      </Pressable>
+    );
+  };
+
+  return (
+    <Modal
+      visible={visible}
+      animationType="slide"
+      onRequestClose={onClose}
+      statusBarTranslucent
+    >
+      <View
+        style={[
+          styles.screen,
+          {
+            backgroundColor: colors.background,
+            paddingTop: insets.top + 12,
+            paddingBottom: insets.bottom + 12,
+          },
+        ]}
+      >
+        <View style={[styles.header, { flexDirection: row }]}>
+          <Pressable
+            accessibilityRole="button"
+            accessibilityLabel={t.quran_close}
+            onPress={onClose}
+            style={[styles.iconButton, { backgroundColor: colors.surface }]}
+          >
+            <X size={22} color={colors.text} />
+          </Pressable>
+          <AppText
+            variant="h3"
+            style={{ color: colors.text, fontWeight: "800", flex: 1, textAlign }}
+          >
+            {t.plan_pick_surahs}
+          </AppText>
+        </View>
+
+        <View
+          style={[
+            styles.search,
+            { backgroundColor: colors.surface, flexDirection: row },
+          ]}
+        >
+          <Search size={18} color={colors.textSecondary} />
+          <TextInput
+            value={query}
+            onChangeText={setQuery}
+            placeholder={t.quran_search}
+            placeholderTextColor={colors.textTertiary}
+            style={[
+              styles.searchInput,
+              { color: colors.text, textAlign: isRTL ? "right" : "left" },
+            ]}
+            accessibilityLabel={t.quran_search}
+            autoCorrect={false}
+          />
+        </View>
+
+        <FlatList
+          data={data}
+          keyExtractor={(item) => String(item.id)}
+          renderItem={renderItem}
+          keyboardShouldPersistTaps="handled"
+          showsVerticalScrollIndicator={false}
+          initialNumToRender={14}
+          contentContainerStyle={styles.list}
+        />
+
+        <Pressable
+          accessibilityRole="button"
+          onPress={confirm}
+          style={[styles.confirm, { backgroundColor: colors.primary }]}
+        >
+          <AppText
+            variant="button"
+            style={{ color: colors.onPrimary, fontWeight: "800" }}
+          >
+            {checked.size > 0
+              ? fill(t.plan_surahs_selected, { count: number(checked.size) })
+              : t.plan_none_selected}
+          </AppText>
+        </Pressable>
+      </View>
+    </Modal>
+  );
+}
+
+const styles = StyleSheet.create({
+  screen: {
+    flex: 1,
+    paddingHorizontal: 20,
+    gap: 12,
+  },
+  header: {
+    alignItems: "center",
+    gap: 12,
+  },
+  iconButton: {
+    width: 44,
+    height: 44,
+    borderRadius: 22,
+    alignItems: "center",
+    justifyContent: "center",
+  },
+  search: {
+    alignItems: "center",
+    gap: 8,
+    borderRadius: 22,
+    paddingHorizontal: 14,
+    minHeight: 46,
+  },
+  searchInput: {
+    flex: 1,
+    fontFamily: "EstedadMedium",
+    fontSize: 15,
+    paddingVertical: 8,
+  },
+  list: {
+    gap: 8,
+    paddingBottom: 8,
+  },
+  rowItem: {
+    alignItems: "center",
+    gap: 12,
+    borderRadius: 18,
+    paddingVertical: 10,
+    paddingHorizontal: 14,
+  },
+  checkbox: {
+    width: 26,
+    height: 26,
+    borderRadius: 8,
+    borderWidth: 2,
+    alignItems: "center",
+    justifyContent: "center",
+  },
+  rowText: {
+    flex: 1,
+    gap: 0,
+  },
+  arabicName: {
+    fontFamily: "UthmanicHafs",
+    fontSize: 24,
+    lineHeight: 42,
+    includeFontPadding: false,
+  },
+  confirm: {
+    minHeight: 52,
+    borderRadius: 26,
+    alignItems: "center",
+    justifyContent: "center",
+  },
+});
diff --git a/src/features/quran/plan/export/buildHtml.ts b/src/features/quran/plan/export/buildHtml.ts
new file mode 100644
index 0000000..28bc881
--- /dev/null
+++ b/src/features/quran/plan/export/buildHtml.ts
@@ -0,0 +1,144 @@
+import type { ExportDoc } from "@/features/quran/plan/export/exportData";
+
+export function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;");
+}
+
+/**
+ * Printable A4 page for expo-print. `fontBase64` is an optional TTF so Persian
+ * text looks the same on every device.
+ */
+export function buildPlanHtml(doc: ExportDoc, fontBase64?: string): string {
+  const dir = doc.rtl ? "rtl" : "ltr";
+  const align = doc.rtl ? "right" : "left";
+  const fontFace = fontBase64
+    ? `@font-face { font-family: "PlanFont"; src: url(data:font/ttf;base64,${fontBase64}) format("truetype"); }`
+    : "";
+  // A plain table (rows of three) renders the same in every print engine.
+  const statCells = doc.summary.map(
+    (item) =>
+      `<td class="stat"><div class="stat-label">${escapeHtml(item.label)}</div><div class="stat-value">${escapeHtml(item.value)}</div></td>`,
+  );
+  const statRows: string[] = [];
+
+  for (let i = 0; i < statCells.length; i += 3) {
+    const row = statCells.slice(i, i + 3);
+
+    while (row.length < 3) {
+      row.push('<td class="stat empty"></td>');
+    }
+
+    statRows.push(`<tr>${row.join("")}</tr>`);
+  }
+
+  const stats = `<table class="stats"><tbody>${statRows.join("")}</tbody></table>`;
+  const head = doc.headers
+    .map((header) => `<th>${escapeHtml(header)}</th>`)
+    .join("");
+  const body = doc.rows
+    .map((row) => {
+      const cells = row.cells
+        .map((cell, i) => {
+          const isLast = i === row.cells.length - 1;
+          const text = escapeHtml(String(cell));
+
+          return isLast
+            ? `<td class="check">${row.done ? `<span class="tick">${text}</span>` : '<span class="box"></span>'}</td>`
+            : `<td>${text}</td>`;
+        })
+        .join("");
+
+      return `<tr class="${row.done ? "done" : ""}">${cells}</tr>`;
+    })
+    .join("");
+
+  return `<!DOCTYPE html>
+<html lang="${doc.language}" dir="${dir}">
+<head>
+<meta charset="utf-8" />
+<meta name="viewport" content="width=device-width, initial-scale=1" />
+<title>${escapeHtml(doc.title)}</title>
+<style>
+${fontFace}
+@page { size: A4; margin: 14mm 12mm; }
+* { box-sizing: border-box; }
+body {
+  margin: 0;
+  color: #17251f;
+  font-family: "PlanFont", "Estedad", "Vazirmatn", "Noto Naskh Arabic", "Noto Sans Arabic", Tahoma, Arial, sans-serif;
+  font-size: 11px;
+  line-height: 1.7;
+  direction: ${dir};
+  text-align: ${align};
+}
+.header {
+  background: #2f6b4f;
+  color: #ffffff;
+  border-radius: 12px;
+  padding: 14px 18px;
+  margin-bottom: 12px;
+}
+.header h1 { margin: 0; font-size: 20px; }
+.header .sub { margin-top: 2px; font-size: 12px; opacity: 0.92; }
+.header .gen { margin-top: 2px; font-size: 10px; opacity: 0.8; }
+table.stats { width: 100%; border-collapse: separate; border-spacing: 6px; margin: 0 -6px 8px; width: calc(100% + 12px); }
+td.stat {
+  width: 33.33%;
+  background: #eaf3ee;
+  border: none;
+  border-radius: 8px;
+  padding: 6px 10px;
+  text-align: ${align};
+  vertical-align: top;
+}
+td.stat.empty { background: transparent; }
+.stat-label { font-size: 9.5px; color: #4b6a5b; }
+.stat-value { font-size: 12px; font-weight: bold; }
+table { width: 100%; border-collapse: collapse; }
+thead { display: table-header-group; }
+th {
+  background: #2f6b4f;
+  color: #ffffff;
+  font-size: 10px;
+  padding: 6px 4px;
+  border: 1px solid #2f6b4f;
+  text-align: center;
+}
+td {
+  padding: 5px 4px;
+  border: 1px solid #d0d7d3;
+  text-align: center;
+  vertical-align: middle;
+}
+tr { page-break-inside: avoid; }
+table.plan tbody tr:nth-child(even) td { background: #f6faf8; }
+table.plan tr.done td { background: #e3f4ea !important; }
+.box {
+  display: inline-block;
+  width: 11px;
+  height: 11px;
+  border: 1.4px solid #2f6b4f;
+  border-radius: 3px;
+  vertical-align: middle;
+}
+.tick { color: #1f7a4d; font-weight: bold; font-size: 13px; }
+</style>
+</head>
+<body>
+<div class="header">
+  <h1>${escapeHtml(doc.title)}</h1>
+  <div class="sub">${escapeHtml(doc.subtitle)}</div>
+  <div class="gen">${escapeHtml(doc.generatedLine)}</div>
+</div>
+${stats}
+<table class="plan">
+  <thead><tr>${head}</tr></thead>
+  <tbody>${body}</tbody>
+</table>
+</body>
+</html>`;
+}
diff --git a/src/features/quran/plan/export/buildSheets.ts b/src/features/quran/plan/export/buildSheets.ts
new file mode 100644
index 0000000..126cba3
--- /dev/null
+++ b/src/features/quran/plan/export/buildSheets.ts
@@ -0,0 +1,64 @@
+import type { ExportDoc } from "@/features/quran/plan/export/exportData";
+import type { Cell, SheetSpec } from "@/features/quran/plan/export/xlsx";
+
+export interface SheetLabels {
+  summary: string;
+  schedule: string;
+}
+
+/** Two sheets: a summary and the day-by-day schedule. */
+export function buildSheets(doc: ExportDoc, labels: SheetLabels): SheetSpec[] {
+  const summaryRows: Cell[][] = [
+    [{ value: doc.title, style: "title" }],
+    [doc.subtitle],
+    [doc.generatedLine],
+    [],
+    ...doc.summary.map(
+      (item): Cell[] => [
+        { value: item.label, style: "label" },
+        { value: item.value, style: "center" },
+      ],
+    ),
+  ];
+
+  const scheduleRows: Cell[][] = [
+    doc.headers.map((value): Cell => ({ value, style: "header" })),
+    ...doc.rows.map((row) =>
+      row.cells.map((value, i): Cell => ({
+        value,
+        style: doc.kinds[i] === "number" ? "center" : i === 0 ? "center" : "text",
+      })),
+    ),
+  ];
+
+  // Column widths follow the column order; the portion and review columns are wide.
+  const widths = doc.headers.map((header, i) => {
+    if (doc.kinds[i] === "number") {
+      return 9;
+    }
+
+    const longest = Math.max(
+      header.length,
+      ...doc.rows.map((row) => String(row.cells[i] ?? "").length),
+    );
+
+    return Math.min(Math.max(longest + 3, 11), 46);
+  });
+
+  return [
+    {
+      name: labels.summary,
+      rows: summaryRows,
+      columnWidths: [30, 44],
+      rtl: doc.rtl,
+    },
+    {
+      name: labels.schedule,
+      rows: scheduleRows,
+      columnWidths: widths,
+      freezeRows: 1,
+      rtl: doc.rtl,
+      landscape: true,
+    },
+  ];
+}
diff --git a/src/features/quran/plan/export/exportData.ts b/src/features/quran/plan/export/exportData.ts
new file mode 100644
index 0000000..711ef5d
--- /dev/null
+++ b/src/features/quran/plan/export/exportData.ts
@@ -0,0 +1,171 @@
+import { formatNumber } from "@/core/i18n/format";
+import type { Language } from "@/core/types/index";
+import { getSurah } from "@/features/quran/data/surahs";
+import {
+  formatDate,
+  formatDateNumeric,
+  weekStartFor,
+  weekdayName,
+  weekdayOrder,
+  type ISODate,
+} from "@/features/quran/plan/calendar";
+import {
+  formatSegments,
+  type PlanConfig,
+  type PlanSession,
+  type PlanSummary,
+} from "@/features/quran/plan/planEngine";
+import { fill } from "@/features/quran/utils/fill";
+
+export type ExportCell = string | number;
+
+export interface ExportRow {
+  cells: ExportCell[];
+  done: boolean;
+}
+
+export interface ExportDoc {
+  language: Language;
+  rtl: boolean;
+  title: string;
+  subtitle: string;
+  generatedLine: string;
+  summary: { label: string; value: string }[];
+  headers: string[];
+  /** Same length as `headers`; "number" columns hold real numbers for Excel. */
+  kinds: ("number" | "text")[];
+  rows: ExportRow[];
+}
+
+interface ExportInput {
+  config: PlanConfig;
+  sessions: readonly PlanSession[];
+  summary: PlanSummary;
+  done: readonly number[];
+  t: Record<string, string>;
+  language: Language;
+  /** Adds the Gregorian date next to the Jalali one (Persian only). */
+  includeGregorian: boolean;
+  today: ISODate;
+}
+
+export function surahLabel(surahId: number, language: Language): string {
+  const surah = getSurah(surahId);
+
+  if (!surah) {
+    return String(surahId);
+  }
+
+  return language === "fa" ? surah.name : surah.transliteration;
+}
+
+export function buildExportDoc(input: ExportInput): ExportDoc {
+  const { config, sessions, summary, done, t, language, today } = input;
+  const number = (value: number) => formatNumber(value, language);
+  const doneSet = new Set(done);
+  const name = (id: number) => surahLabel(id, language);
+  const portion = (segments: PlanSession["segments"]) =>
+    formatSegments(segments, number, name);
+  const withGregorian = input.includeGregorian && language === "fa";
+  const total = Math.max(summary.totalAyahs, 1);
+
+  const headers = [
+    t.plan_col_no,
+    t.plan_col_date,
+    ...(withGregorian ? [t.plan_col_gregorian] : []),
+    t.plan_col_weekday,
+    t.plan_col_portion,
+    t.plan_col_count,
+    t.plan_col_total,
+    t.plan_col_percent,
+    t.plan_col_review,
+    t.plan_col_done,
+  ].map((value) => value ?? "");
+  const kinds: ExportDoc["kinds"] = [
+    "number",
+    "text",
+    ...(withGregorian ? (["text"] as const) : []),
+    "text",
+    "text",
+    "number",
+    "number",
+    "text",
+    "text",
+    "text",
+  ];
+
+  const rows: ExportRow[] = sessions.map((session) => {
+    const isDone = doneSet.has(session.index);
+
+    return {
+      done: isDone,
+      cells: [
+        session.index + 1,
+        formatDateNumeric(session.date, language),
+        ...(withGregorian ? [session.date] : []),
+        weekdayName(language, new Date(`${session.date}T00:00:00Z`).getUTCDay()),
+        portion(session.segments),
+        session.count,
+        session.cumulative,
+        `${number(Math.round((session.cumulative / total) * 100))}${language === "fa" ? "٪" : "%"}`,
+        session.review.length > 0 ? portion(session.review) : "—",
+        isDone ? "✓" : "",
+      ],
+    };
+  });
+
+  const perSession =
+    summary.minPerSession === summary.maxPerSession
+      ? number(summary.maxPerSession)
+      : `${number(summary.minPerSession)}–${number(summary.maxPerSession)}`;
+  const days = weekdayOrder(weekStartFor(language))
+    .filter((day) => config.weekdays.includes(day))
+    .map((day) => weekdayName(language, day))
+    .join(language === "fa" ? "، " : ", ");
+  const finished = sessions.filter((session) => doneSet.has(session.index));
+  const finishedAyahs = finished.reduce((sum, session) => sum + session.count, 0);
+  const subtitle = config.surahIds
+    .map((id) => {
+      const surah = getSurah(id);
+
+      return surah ? name(id) : "";
+    })
+    .filter(Boolean)
+    .join(language === "fa" ? "، " : ", ");
+
+  return {
+    language,
+    rtl: language === "fa",
+    title: t.plan_export_title ?? "",
+    subtitle,
+    generatedLine: fill(t.plan_export_generated, {
+      date: formatDate(today, language),
+    }),
+    summary: [
+      { label: t.plan_sum_total ?? "", value: number(summary.totalAyahs) },
+      { label: t.plan_sum_sessions ?? "", value: number(summary.sessionCount) },
+      { label: t.plan_sum_per_session ?? "", value: perSession },
+      { label: t.plan_sum_days ?? "", value: days },
+      {
+        label: t.plan_sum_start ?? "",
+        value: summary.firstDate ? formatDate(summary.firstDate, language) : "—",
+      },
+      {
+        label: t.plan_sum_end ?? "",
+        value: summary.lastDate ? formatDate(summary.lastDate, language) : "—",
+      },
+      {
+        label: t.plan_sum_progress ?? "",
+        value: fill(t.plan_sum_progress_value, {
+          done: number(finished.length),
+          sessions: number(summary.sessionCount),
+          ayahs: number(finishedAyahs),
+          total: number(summary.totalAyahs),
+        }),
+      },
+    ],
+    headers,
+    kinds,
+    rows,
+  };
+}
diff --git a/src/features/quran/plan/export/exportPlan.ts b/src/features/quran/plan/export/exportPlan.ts
new file mode 100644
