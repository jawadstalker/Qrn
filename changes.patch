diff --git a/src/features/quran/audio/DownloadContext.tsx b/src/features/quran/audio/DownloadContext.tsx
new file mode 100644
index 0000000..287ab91
--- /dev/null
+++ b/src/features/quran/audio/DownloadContext.tsx
@@ -0,0 +1,185 @@
+import React, {
+  createContext,
+  useCallback,
+  useContext,
+  useEffect,
+  useMemo,
+  useState,
+  type ReactNode,
+} from "react";
+import * as Haptics from "expo-haptics";
+import {
+  DownloadCancelledError,
+  downloadManager,
+  getDownloadId,
+  type ActiveDownloadProgress,
+  type AudioDownloadRecord,
+} from "./downloadManager";
+
+export type DownloadState = "idle" | "downloading" | "downloaded" | "error";
+
+export interface DownloadStatus {
+  state: DownloadState;
+  /** 0..1, only meaningful while downloading. */
+  progress: number;
+  record: AudioDownloadRecord | null;
+}
+
+interface DownloadContextValue {
+  downloads: AudioDownloadRecord[];
+  activeDownloads: Record<string, ActiveDownloadProgress>;
+  totalDownloadSize: number;
+  /** Resolves true when the file is saved, false when it failed or was cancelled. Never throws. */
+  downloadSurah: (surahId: number, reciterId: string) => Promise<boolean>;
+  cancelDownload: (surahId: number, reciterId: string) => Promise<void>;
+  deleteDownload: (surahId: number, reciterId: string) => Promise<void>;
+  deleteAllDownloads: () => Promise<void>;
+  clearDownloadError: (surahId: number, reciterId: string) => void;
+  getDownloadStatus: (surahId: number, reciterId: string) => DownloadStatus;
+}
+
+const DownloadContext = createContext<DownloadContextValue | undefined>(
+  undefined,
+);
+
+function haptic(kind: "tap" | "success" | "error") {
+  try {
+    if (kind === "tap") {
+      void Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);
+    } else {
+      void Haptics.notificationAsync(
+        kind === "success"
+          ? Haptics.NotificationFeedbackType.Success
+          : Haptics.NotificationFeedbackType.Error,
+      );
+    }
+  } catch {
+    // Haptics are a bonus.
+  }
+}
+
+export function DownloadProvider({ children }: { children: ReactNode }) {
+  const [downloads, setDownloads] = useState<AudioDownloadRecord[]>([]);
+  const [activeDownloads, setActiveDownloads] = useState<
+    Record<string, ActiveDownloadProgress>
+  >({});
+
+  useEffect(
+    () =>
+      downloadManager.subscribe((snapshot) => {
+        setDownloads(snapshot.records);
+        setActiveDownloads(snapshot.active);
+      }),
+    [],
+  );
+
+  const totalDownloadSize = useMemo(
+    () => downloads.reduce((sum, item) => sum + (item.fileSize || 0), 0),
+    [downloads],
+  );
+
+  const downloadSurah = useCallback(
+    async (surahId: number, reciterId: string): Promise<boolean> => {
+      haptic("tap");
+
+      try {
+        await downloadManager.startDownload(surahId, reciterId);
+        haptic("success");
+
+        return true;
+      } catch (error) {
+        if (!(error instanceof DownloadCancelledError)) {
+          haptic("error");
+        }
+
+        return false;
+      }
+    },
+    [],
+  );
+
+  const cancelDownload = useCallback(
+    (surahId: number, reciterId: string) =>
+      downloadManager.cancelDownload(surahId, reciterId),
+    [],
+  );
+
+  const deleteDownload = useCallback(
+    (surahId: number, reciterId: string) =>
+      downloadManager.deleteRecord(surahId, reciterId),
+    [],
+  );
+
+  const deleteAllDownloads = useCallback(
+    () => downloadManager.deleteAllDownloads(),
+    [],
+  );
+
+  const clearDownloadError = useCallback(
+    (surahId: number, reciterId: string) =>
+      downloadManager.clearError(surahId, reciterId),
+    [],
+  );
+
+  const getDownloadStatus = useCallback(
+    (surahId: number, reciterId: string): DownloadStatus => {
+      const id = getDownloadId(surahId, reciterId);
+      const active = activeDownloads[id];
+      const record = downloads.find((item) => item.id === id) ?? null;
+
+      if (active?.status === "downloading") {
+        return { state: "downloading", progress: active.progress, record };
+      }
+
+      if (record) {
+        return { state: "downloaded", progress: 1, record };
+      }
+
+      if (active?.status === "error") {
+        return { state: "error", progress: 0, record: null };
+      }
+
+      return { state: "idle", progress: 0, record: null };
+    },
+    [activeDownloads, downloads],
+  );
+
+  const value = useMemo(
+    () => ({
+      downloads,
+      activeDownloads,
+      totalDownloadSize,
+      downloadSurah,
+      cancelDownload,
+      deleteDownload,
+      deleteAllDownloads,
+      clearDownloadError,
+      getDownloadStatus,
+    }),
+    [
+      downloads,
+      activeDownloads,
+      totalDownloadSize,
+      downloadSurah,
+      cancelDownload,
+      deleteDownload,
+      deleteAllDownloads,
+      clearDownloadError,
+      getDownloadStatus,
+    ],
+  );
+
+  return (
+    <DownloadContext.Provider value={value}>{children}</DownloadContext.Provider>
+  );
+}
+
+export function useDownload(): DownloadContextValue {
+  const context = useContext(DownloadContext);
+
+  if (!context) {
+    throw new Error("useDownload must be used within DownloadProvider");
+  }
+
+  return context;
+}
diff --git a/src/features/quran/audio/downloadManager.ts b/src/features/quran/audio/downloadManager.ts
new file mode 100644
index 0000000..e51b5eb
--- /dev/null
+++ b/src/features/quran/audio/downloadManager.ts
@@ -0,0 +1,497 @@
+import { Platform } from "react-native";
+import * as FileSystem from "expo-file-system";
+import AsyncStorage from "@react-native-async-storage/async-storage";
+import { getReciter } from "@/features/quran/data/reciters";
+
+export interface AudioDownloadRecord {
+  id: string; // `${reciterId}_${surahId}`
+  surahId: number;
+  reciterId: string;
+  localUri: string;
+  fileSize: number; // bytes
+  downloadedAt: number; // timestamp
+}
+
+export interface ActiveDownloadProgress {
+  id: string;
+  surahId: number;
+  reciterId: string;
+  progress: number; // 0..1
+  totalBytes: number;
+  downloadedBytes: number;
+  status: "downloading" | "error";
+}
+
+export interface DownloadSnapshot {
+  records: AudioDownloadRecord[];
+  active: Record<string, ActiveDownloadProgress>;
+}
+
+/** Thrown by startDownload when the person cancelled it. It is not a failure. */
+export class DownloadCancelledError extends Error {
+  constructor() {
+    super("cancelled");
+    this.name = "DownloadCancelledError";
+  }
+}
+
+const METADATA_KEY = "@quran_audio_downloads_v2";
+/** Older builds (feature-task) stored records here, with a quality suffix in the id. */
+const LEGACY_METADATA_KEY = "@quran_audio_downloads_v1";
+/** A real surah recording is never smaller than this; smaller means an error page was saved. */
+const MIN_VALID_BYTES = 20 * 1024;
+/** Progress updates reach the UI at most this often (ms). */
+const EMIT_INTERVAL = 120;
+
+export function getDownloadId(surahId: number, reciterId: string): string {
+  return `${reciterId}_${surahId}`;
+}
+
+export function getAudioDownloadUrl(surahId: number, reciterId: string): string {
+  return getReciter(reciterId).surahUrl(surahId);
+}
+
+export function formatBytes(bytes: number): string {
+  if (bytes <= 0 || !Number.isFinite(bytes)) {
+    return "0 MB";
+  }
+
+  const megabytes = bytes / (1024 * 1024);
+
+  if (megabytes < 1) {
+    return `${Math.max(1, Math.round(bytes / 1024))} KB`;
+  }
+
+  return `${megabytes.toFixed(1)} MB`;
+}
+
+const isNative = () => Platform.OS !== "web" && !!FileSystem.documentDirectory;
+
+class DownloadManager {
+  private records: AudioDownloadRecord[] = [];
+  private progress: Record<string, ActiveDownloadProgress> = {};
+  private resumables = new Map<string, FileSystem.DownloadResumable>();
+  private inFlight = new Map<string, Promise<AudioDownloadRecord>>();
+  private cancelled = new Set<string>();
+  private listeners = new Set<(snapshot: DownloadSnapshot) => void>();
+  private initPromise: Promise<void> | null = null;
+  private lastEmit = 0;
+
+  private audioDir(): string {
+    return `${FileSystem.documentDirectory ?? ""}quran_audio/`;
+  }
+
+  /** Loads the saved list once. Safe to call from anywhere, any number of times. */
+  init(): Promise<void> {
+    if (!this.initPromise) {
+      this.initPromise = this.load();
+    }
+
+    return this.initPromise;
+  }
+
+  private async load(): Promise<void> {
+    try {
+      if (isNative()) {
+        const info = await FileSystem.getInfoAsync(this.audioDir());
+
+        if (!info.exists) {
+          await FileSystem.makeDirectoryAsync(this.audioDir(), {
+            intermediates: true,
+          });
+        }
+      }
+
+      const stored =
+        (await AsyncStorage.getItem(METADATA_KEY)) ??
+        (await AsyncStorage.getItem(LEGACY_METADATA_KEY));
+      const parsed: unknown = stored ? JSON.parse(stored) : [];
+      const valid: AudioDownloadRecord[] = [];
+
+      if (Array.isArray(parsed)) {
+        for (const item of parsed as Partial<AudioDownloadRecord>[]) {
+          if (
+            typeof item?.surahId !== "number" ||
+            typeof item.reciterId !== "string" ||
+            typeof item.localUri !== "string"
+          ) {
+            continue;
+          }
+
+          // Browser object URLs die with the page, so they cannot be kept across launches.
+          if (item.localUri.startsWith("blob:")) {
+            continue;
+          }
+
+          if (isNative()) {
+            const info = await FileSystem.getInfoAsync(item.localUri);
+
+            if (!info.exists) {
+              continue;
+            }
+          }
+
+          const id = getDownloadId(item.surahId, item.reciterId);
+
+          if (!valid.some((record) => record.id === id)) {
+            valid.push({
+              id,
+              surahId: item.surahId,
+              reciterId: item.reciterId,
+              localUri: item.localUri,
+              fileSize: typeof item.fileSize === "number" ? item.fileSize : 0,
+              downloadedAt:
+                typeof item.downloadedAt === "number" ? item.downloadedAt : 0,
+            });
+          }
+        }
+      }
+
+      this.records = valid;
+    } catch {
+      this.records = [];
+    }
+
+    this.emit(true);
+  }
+
+  private async persist(): Promise<void> {
+    try {
+      const keep = this.records.filter(
+        (record) => !record.localUri.startsWith("blob:"),
+      );
+
+      await AsyncStorage.setItem(METADATA_KEY, JSON.stringify(keep));
+    } catch {
+      // The files are still on disk; the list is rebuilt from what was saved last.
+    }
+  }
+
+  private snapshot(): DownloadSnapshot {
+    return { records: [...this.records], active: { ...this.progress } };
+  }
+
+  private emit(force = false): void {
+    const now = Date.now();
+
+    if (!force && now - this.lastEmit < EMIT_INTERVAL) {
+      return;
+    }
+
+    this.lastEmit = now;
+
+    const snapshot = this.snapshot();
+
+    this.listeners.forEach((listener) => {
+      try {
+        listener(snapshot);
+      } catch {
+        // One broken listener must not stop the others.
+      }
+    });
+  }
+
+  subscribe(listener: (snapshot: DownloadSnapshot) => void): () => void {
+    this.listeners.add(listener);
+    listener(this.snapshot());
+    void this.init();
+
+    return () => {
+      this.listeners.delete(listener);
+    };
+  }
+
+  getRecords(): AudioDownloadRecord[] {
+    return [...this.records];
+  }
+
+  /** The playable local file of a surah, or null. Used by the player; synchronous on purpose. */
+  getCachedUriSync(surahId: number, reciterId?: string): string | null {
+    const match = this.records.find(
+      (record) =>
+        record.surahId === surahId &&
+        (reciterId === undefined || record.reciterId === reciterId),
+    );
+
+    return match ? match.localUri : null;
+  }
+
+  isDownloading(surahId: number, reciterId: string): boolean {
+    return this.inFlight.has(getDownloadId(surahId, reciterId));
+  }
+
+  startDownload(
+    surahId: number,
+    reciterId: string,
+  ): Promise<AudioDownloadRecord> {
+    const id = getDownloadId(surahId, reciterId);
+    const running = this.inFlight.get(id);
+
+    // A second tap while the first is running joins it instead of starting a second copy.
+    if (running) {
+      return running;
+    }
+
+    const job = this.run(surahId, reciterId).finally(() => {
+      this.inFlight.delete(id);
+      this.resumables.delete(id);
+      this.cancelled.delete(id);
+    });
+
+    this.inFlight.set(id, job);
+
+    return job;
+  }
+
+  private fail(id: string, surahId: number, reciterId: string): void {
+    this.progress[id] = {
+      id,
+      surahId,
+      reciterId,
+      progress: 0,
+      totalBytes: 0,
+      downloadedBytes: 0,
+      status: "error",
+    };
+    this.emit(true);
+  }
+
+  private async run(
+    surahId: number,
+    reciterId: string,
+  ): Promise<AudioDownloadRecord> {
+    await this.init();
+
+    const id = getDownloadId(surahId, reciterId);
+    const existing = this.records.find((record) => record.id === id);
+
+    if (existing) {
+      return existing;
+    }
+
+    const url = getAudioDownloadUrl(surahId, reciterId);
+
+    this.progress[id] = {
+      id,
+      surahId,
+      reciterId,
+      progress: 0,
+      totalBytes: 0,
+      downloadedBytes: 0,
+      status: "downloading",
+    };
+    this.emit(true);
+
+    try {
+      const record = isNative()
+        ? await this.downloadNative(id, surahId, reciterId, url)
+        : await this.downloadWeb(id, surahId, reciterId, url);
+
+      if (this.cancelled.has(id)) {
+        throw new DownloadCancelledError();
+      }
+
+      this.records = [...this.records.filter((item) => item.id !== id), record];
+      delete this.progress[id];
+      this.emit(true);
+      void this.persist();
+
+      return record;
+    } catch (error) {
+      if (this.cancelled.has(id) || error instanceof DownloadCancelledError) {
+        delete this.progress[id];
+        this.emit(true);
+
+        throw new DownloadCancelledError();
+      }
+
+      this.fail(id, surahId, reciterId);
+
+      throw error;
+    }
+  }
+
+  private async downloadNative(
+    id: string,
+    surahId: number,
+    reciterId: string,
+    url: string,
+  ): Promise<AudioDownloadRecord> {
+    const finalUri = `${this.audioDir()}${id}.mp3`;
+    // Downloaded under a temporary name, so a half-finished file is never mistaken for a good one.
+    const partUri = `${finalUri}.part`;
+
+    await FileSystem.deleteAsync(partUri, { idempotent: true });
+
+    const resumable = FileSystem.createDownloadResumable(
+      url,
+      partUri,
+      {},
+      (event) => {
+        const total = event.totalBytesExpectedToWrite;
+        const written = event.totalBytesWritten;
+
+        this.progress[id] = {
+          id,
+          surahId,
+          reciterId,
+          progress: total > 0 ? Math.min(written / total, 0.99) : 0,
+          totalBytes: total,
+          downloadedBytes: written,
+          status: "downloading",
+        };
+        this.emit();
+      },
+    );
+
+    this.resumables.set(id, resumable);
+
+    let result: FileSystem.FileSystemDownloadResult | undefined;
+
+    try {
+      result = await resumable.downloadAsync();
+    } catch (error) {
+      await FileSystem.deleteAsync(partUri, { idempotent: true });
+
+      throw error;
+    }
+
+    // Paused (cancelled) downloads resolve with nothing.
+    if (this.cancelled.has(id) || !result) {
+      await FileSystem.deleteAsync(partUri, { idempotent: true });
+
+      throw new DownloadCancelledError();
+    }
+
+    // The server answered, but with an error page (404, 500...) that expo saved as if it was audio.
+    if (result.status < 200 || result.status >= 300) {
+      await FileSystem.deleteAsync(partUri, { idempotent: true });
+
+      throw new Error(`HTTP ${result.status}`);
+    }
+
+    const info = await FileSystem.getInfoAsync(partUri);
+    const size = info.exists && "size" in info ? (info.size ?? 0) : 0;
+
+    if (size < MIN_VALID_BYTES) {
+      await FileSystem.deleteAsync(partUri, { idempotent: true });
+
+      throw new Error("file too small");
+    }
+
+    await FileSystem.deleteAsync(finalUri, { idempotent: true });
+    await FileSystem.moveAsync({ from: partUri, to: finalUri });
+
+    return {
+      id,
+      surahId,
+      reciterId,
+      localUri: finalUri,
+      fileSize: size,
+      downloadedAt: Date.now(),
+    };
+  }
+
+  /** Browsers have no document folder: keep the file as an in-memory object URL for this visit. */
+  private async downloadWeb(
+    id: string,
+    surahId: number,
+    reciterId: string,
+    url: string,
+  ): Promise<AudioDownloadRecord> {
+    const response = await fetch(url);
+
+    if (!response.ok) {
+      throw new Error(`HTTP ${response.status}`);
+    }
+
+    const blob = await response.blob();
+
+    if (blob.size < MIN_VALID_BYTES) {
+      throw new Error("file too small");
+    }
+
+    return {
+      id,
+      surahId,
+      reciterId,
+      localUri: URL.createObjectURL(blob),
+      fileSize: blob.size,
+      downloadedAt: Date.now(),
+    };
+  }
+
+  async cancelDownload(surahId: number, reciterId: string): Promise<void> {
+    const id = getDownloadId(surahId, reciterId);
+    const resumable = this.resumables.get(id);
+
+    if (!this.inFlight.has(id)) {
+      // A failed download only leaves its error flag behind; cancelling clears it.
+      delete this.progress[id];
+      this.emit(true);
+
+      return;
+    }
+
+    this.cancelled.add(id);
+
+    try {
+      await resumable?.pauseAsync();
+    } catch {
+      // The download may have just finished; the cancelled flag decides what happens next.
+    }
+  }
+
+  clearError(surahId: number, reciterId: string): void {
+    const id = getDownloadId(surahId, reciterId);
+
+    if (this.progress[id]?.status === "error") {
+      delete this.progress[id];
+      this.emit(true);
+    }
+  }
+
+  async deleteRecord(surahId: number, reciterId: string): Promise<void> {
+    await this.init();
+
+    const id = getDownloadId(surahId, reciterId);
+    const target = this.records.find((record) => record.id === id);
+
+    if (!target) {
+      return;
+    }
+
+    await this.removeFile(target);
+    this.records = this.records.filter((record) => record.id !== id);
+    this.emit(true);
+    await this.persist();
+  }
+
+  async deleteAllDownloads(): Promise<void> {
+    await this.init();
+
+    const all = [...this.records];
+
+    this.records = [];
+    this.emit(true);
+    await Promise.all(all.map((record) => this.removeFile(record)));
+    await this.persist();
+  }
+
+  private async removeFile(record: AudioDownloadRecord): Promise<void> {
+    try {
+      if (record.localUri.startsWith("blob:")) {
+        URL.revokeObjectURL(record.localUri);
+      } else if (isNative()) {
+        await FileSystem.deleteAsync(record.localUri, { idempotent: true });
+      }
+    } catch {
+      // A file that is already gone is the goal anyway.
+    }
+  }
+}
+
+export const downloadManager = new DownloadManager();
+
+// Start reading the saved list as soon as the app loads, so offline files are found when playing.
+void downloadManager.init();
diff --git a/src/features/quran/components/DownloadButton.tsx b/src/features/quran/components/DownloadButton.tsx
new file mode 100644
index 0000000..2e98d68
--- /dev/null
+++ b/src/features/quran/components/DownloadButton.tsx
@@ -0,0 +1,203 @@
+import React, { useCallback } from "react";
+import {
+  ActivityIndicator,
+  Pressable,
+  StyleSheet,
+  View,
+  type StyleProp,
+  type ViewStyle,
+} from "react-native";
+import Svg, { Circle } from "react-native-svg";
+import {
+  CircleAlert,
+  CircleCheck,
+  Download,
+  X,
+} from "lucide-react-native";
+import { useDownload } from "@/features/quran/audio/DownloadContext";
+import { getSurah } from "@/features/quran/data/surahs";
+import { useLanguage } from "@/core/i18n/LanguageContext";
+import { useTheme } from "@/core/theme/ThemeContext";
+import { fill } from "@/features/quran/utils/fill";
+import { confirmAction } from "@/features/quran/utils/confirm";
+
+interface DownloadButtonProps {
+  surahId: number;
+  reciterId: string;
+  /** Icon size; the touch circle is 18 larger. */
+  size?: number;
+  style?: StyleProp<ViewStyle>;
+}
+
+const DONE = "#10B981";
+const BUSY = "#3B82F6";
+const FAILED = "#EF4444";
+const RING_STROKE = 2.5;
+
+/**
+ * One tap on the audio of a surah:
+ *   idle        -> starts the download
+ *   downloading -> a progress ring; tapping cancels
+ *   downloaded  -> a green check; tapping asks before removing the file
+ *   error       -> a red mark; tapping tries again
+ */
+export function DownloadButton({
+  surahId,
+  reciterId,
+  size = 20,
+  style,
+}: DownloadButtonProps) {
+  const { colors } = useTheme();
+  const { t, language } = useLanguage();
+  const {
+    getDownloadStatus,
+    downloadSurah,
+    cancelDownload,
+    deleteDownload,
+    clearDownloadError,
+  } = useDownload();
+  const status = getDownloadStatus(surahId, reciterId);
+  const circle = size + 18;
+  const radius = (circle - RING_STROKE) / 2;
+  const circumference = 2 * Math.PI * radius;
+
+  const handlePress = useCallback(async () => {
+    if (status.state === "downloading") {
+      await cancelDownload(surahId, reciterId);
+
+      return;
+    }
+
+    if (status.state === "downloaded") {
+      const surah = getSurah(surahId);
+      const confirmed = await confirmAction({
+        title: t.dl_delete_title,
+        message: fill(t.dl_delete_body, {
+          surah: (language === "fa" ? surah?.name : surah?.transliteration) ?? "",
+        }),
+        confirmLabel: t.dl_delete_confirm,
+        cancelLabel: t.dl_cancel,
+        destructive: true,
+      });
+
+      if (confirmed) {
+        await deleteDownload(surahId, reciterId);
+      }
+
+      return;
+    }
+
+    if (status.state === "error") {
+      clearDownloadError(surahId, reciterId);
+    }
+
+    await downloadSurah(surahId, reciterId);
+  }, [
+    cancelDownload,
+    clearDownloadError,
+    deleteDownload,
+    downloadSurah,
+    language,
+    reciterId,
+    status.state,
+    surahId,
+    t,
+  ]);
+
+  const label =
+    status.state === "downloading"
+      ? `${t.dl_a11y_cancel} (${Math.round(status.progress * 100)}%)`
+      : status.state === "downloaded"
+        ? t.dl_a11y_downloaded
+        : status.state === "error"
+          ? t.dl_a11y_retry
+          : t.dl_a11y_download;
+  const background =
+    status.state === "downloaded"
+      ? "rgba(16, 185, 129, 0.14)"
+      : status.state === "downloading"
+        ? "rgba(59, 130, 246, 0.12)"
+        : status.state === "error"
+          ? "rgba(239, 68, 68, 0.12)"
+          : colors.tintSoft;
+
+  return (
+    <Pressable
+      accessibilityRole="button"
+      accessibilityLabel={label}
+      accessibilityState={{ busy: status.state === "downloading" }}
+      hitSlop={6}
+      onPress={(event) => {
+        event.stopPropagation();
+        void handlePress();
+      }}
+      style={({ pressed }) => [
+        styles.button,
+        {
+          width: circle,
+          height: circle,
+          borderRadius: circle / 2,
+          backgroundColor: background,
+          opacity: pressed ? 0.7 : 1,
+        },
+        style,
+      ]}
+    >
+      {status.state === "downloading" ? (
+        <View style={[styles.center, { width: circle, height: circle }]}>
+          <Svg
+            width={circle}
+            height={circle}
+            style={StyleSheet.absoluteFill}
+            pointerEvents="none"
+          >
+            <Circle
+              cx={circle / 2}
+              cy={circle / 2}
+              r={radius}
+              stroke="rgba(59, 130, 246, 0.2)"
+              strokeWidth={RING_STROKE}
+              fill="none"
+            />
+            {status.progress > 0 ? (
+              <Circle
+                cx={circle / 2}
+                cy={circle / 2}
+                r={radius}
+                stroke={BUSY}
+                strokeWidth={RING_STROKE}
+                strokeLinecap="round"
+                fill="none"
+                strokeDasharray={`${circumference} ${circumference}`}
+                strokeDashoffset={circumference * (1 - status.progress)}
+                transform={`rotate(-90 ${circle / 2} ${circle / 2})`}
+              />
+            ) : null}
+          </Svg>
+          {status.progress > 0 ? (
+            <X size={size - 4} color={BUSY} />
+          ) : (
+            <ActivityIndicator size="small" color={BUSY} />
+          )}
+        </View>
+      ) : status.state === "downloaded" ? (
+        <CircleCheck size={size} color={DONE} />
+      ) : status.state === "error" ? (
+        <CircleAlert size={size} color={FAILED} />
+      ) : (
+        <Download size={size} color={colors.textSecondary} />
+      )}
+    </Pressable>
+  );
+}
+
+const styles = StyleSheet.create({
+  button: {
+    alignItems: "center",
+    justifyContent: "center",
+  },
+  center: {
+    alignItems: "center",
+    justifyContent: "center",
+  },
+});
