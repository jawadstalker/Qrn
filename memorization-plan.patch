+++ b/src/features/quran/plan/export/exportPlan.ts
@@ -0,0 +1,129 @@
+import { Platform } from "react-native";
+import { Asset } from "expo-asset";
+import * as FileSystem from "expo-file-system";
+import * as Print from "expo-print";
+import * as Sharing from "expo-sharing";
+import { buildPlanHtml } from "@/features/quran/plan/export/buildHtml";
+import { buildSheets } from "@/features/quran/plan/export/buildSheets";
+import type { ExportDoc } from "@/features/quran/plan/export/exportData";
+import {
+  XLSX_MIME,
+  buildXlsxBase64,
+  buildXlsxBytes,
+} from "@/features/quran/plan/export/xlsx";
+
+export type ExportResult = "shared" | "saved" | "unavailable";
+
+const PDF_MIME = "application/pdf";
+const XLSX_UTI = "org.openxmlformats.spreadsheetml.sheet";
+
+let cachedFont: string | null | undefined;
+
+/** The Persian UI font as base64, or null when it cannot be read. */
+async function loadFontBase64(): Promise<string | null> {
+  if (cachedFont !== undefined) {
+    return cachedFont;
+  }
+
+  try {
+    const asset = Asset.fromModule(
+      require("../../../../../assets/fonts/Estedad-Medium.ttf"),
+    );
+
+    await asset.downloadAsync();
+
+    cachedFont = asset.localUri
+      ? await FileSystem.readAsStringAsync(asset.localUri, {
+          encoding: FileSystem.EncodingType.Base64,
+        })
+      : null;
+  } catch {
+    cachedFont = null;
+  }
+
+  return cachedFont;
+}
+
+function fileName(base: string, extension: string): string {
+  const stamp = new Date().toISOString().slice(0, 10);
+
+  return `${base}-${stamp}.${extension}`;
+}
+
+async function share(
+  uri: string,
+  mimeType: string,
+  uti: string,
+  title: string,
+): Promise<ExportResult> {
+  if (!(await Sharing.isAvailableAsync())) {
+    return "unavailable";
+  }
+
+  await Sharing.shareAsync(uri, { mimeType, UTI: uti, dialogTitle: title });
+
+  return "shared";
+}
+
+function downloadOnWeb(bytes: Uint8Array, name: string, mime: string): void {
+  const blob = new Blob([bytes], { type: mime });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+
+  link.href = url;
+  link.download = name;
+  document.body.appendChild(link);
+  link.click();
+  document.body.removeChild(link);
+  URL.revokeObjectURL(url);
+}
+
+export async function exportPlanPdf(
+  doc: ExportDoc,
+  baseName: string,
+): Promise<ExportResult> {
+  const html = buildPlanHtml(doc, (await loadFontBase64()) ?? undefined);
+
+  if (Platform.OS === "web") {
+    await Print.printAsync({ html });
+
+    return "saved";
+  }
+
+  const printed = await Print.printToFileAsync({ html });
+  const target = `${FileSystem.cacheDirectory}${fileName(baseName, "pdf")}`;
+  let uri = printed.uri;
+
+  try {
+    await FileSystem.deleteAsync(target, { idempotent: true });
+    await FileSystem.moveAsync({ from: printed.uri, to: target });
+    uri = target;
+  } catch {
+    // The generated file name is fine too.
+  }
+
+  return share(uri, PDF_MIME, "com.adobe.pdf", doc.title);
+}
+
+export async function exportPlanExcel(
+  doc: ExportDoc,
+  baseName: string,
+  labels: { summary: string; schedule: string },
+): Promise<ExportResult> {
+  const sheets = buildSheets(doc, labels);
+  const name = fileName(baseName, "xlsx");
+
+  if (Platform.OS === "web") {
+    downloadOnWeb(await buildXlsxBytes(sheets), name, XLSX_MIME);
+
+    return "saved";
+  }
+
+  const uri = `${FileSystem.cacheDirectory}${name}`;
+
+  await FileSystem.writeAsStringAsync(uri, await buildXlsxBase64(sheets), {
+    encoding: FileSystem.EncodingType.Base64,
+  });
+
+  return share(uri, XLSX_MIME, XLSX_UTI, doc.title);
+}
diff --git a/src/features/quran/plan/export/xlsx.ts b/src/features/quran/plan/export/xlsx.ts
new file mode 100644
index 0000000..b1ff70e
--- /dev/null
+++ b/src/features/quran/plan/export/xlsx.ts
@@ -0,0 +1,284 @@
+import JSZip from "jszip";
+
+/**
+ * Minimal .xlsx writer (SpreadsheetML) on top of JSZip.
+ * Supports several sheets, column widths, a frozen header row, right-to-left
+ * sheets and a few cell styles. Strings are written inline, so no shared
+ * string table is needed.
+ */
+
+export type CellStyle = "title" | "header" | "label" | "center" | "text";
+
+export interface StyledCell {
+  value: string | number;
+  style?: CellStyle;
+}
+
+export type Cell = string | number | StyledCell | null;
+
+export interface SheetSpec {
+  name: string;
+  rows: Cell[][];
+  columnWidths?: number[];
+  /** Freeze the first N rows. */
+  freezeRows?: number;
+  rtl?: boolean;
+  /** Print on a landscape page (always one page wide). */
+  landscape?: boolean;
+}
+
+const STYLE_ID: Record<CellStyle, number> = {
+  text: 0,
+  title: 1,
+  header: 2,
+  label: 3,
+  center: 4,
+};
+
+const FONT = "Tahoma";
+
+// Characters XML 1.0 does not allow.
+// eslint-disable-next-line no-control-regex
+const INVALID_XML = /[\u0000-\u0008\u000B\u000C\u000E-\u001F\uFFFE\uFFFF]/g;
+
+function escapeXml(value: string): string {
+  return value
+    .replace(INVALID_XML, "")
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;");
+}
+
+export function columnLetter(index: number): string {
+  let n = index + 1;
+  let letters = "";
+
+  while (n > 0) {
+    const rest = (n - 1) % 26;
+
+    letters = String.fromCharCode(65 + rest) + letters;
+    n = Math.floor((n - 1) / 26);
+  }
+
+  return letters;
+}
+
+export function safeSheetName(name: string, taken: readonly string[]): string {
+  const cleaned =
+    name.replace(/[\\/?*[\]:]/g, " ").trim().slice(0, 31) || "Sheet";
+  let candidate = cleaned;
+  let n = 2;
+
+  while (taken.includes(candidate)) {
+    const suffix = ` ${n}`;
+
+    candidate = cleaned.slice(0, 31 - suffix.length) + suffix;
+    n += 1;
+  }
+
+  return candidate;
+}
+
+function normalize(cell: Cell): StyledCell | null {
+  if (cell === null) {
+    return null;
+  }
+
+  if (typeof cell === "object") {
+    return cell;
+  }
+
+  return { value: cell };
+}
+
+function sheetXml(sheet: SheetSpec): string {
+  const widths = sheet.columnWidths ?? [];
+  const freeze = sheet.freezeRows ?? 0;
+  const maxColumns = sheet.rows.reduce((max, row) => Math.max(max, row.length), 0);
+  const lastRef = `${columnLetter(Math.max(maxColumns - 1, 0))}${Math.max(sheet.rows.length, 1)}`;
+  const view = `<sheetViews><sheetView workbookViewId="0"${sheet.rtl ? ' rightToLeft="1"' : ""}${
+    freeze > 0
+      ? `><pane ySplit="${freeze}" topLeftCell="A${freeze + 1}" activePane="bottomLeft" state="frozen"/></sheetView>`
+      : "/>"
+  }</sheetViews>`;
+  const cols =
+    widths.length > 0
+      ? `<cols>${widths
+          .map(
+            (width, i) =>
+              `<col min="${i + 1}" max="${i + 1}" width="${width}" customWidth="1"/>`,
+          )
+          .join("")}</cols>`
+      : "";
+  const rows = sheet.rows
+    .map((row, r) => {
+      const cells = row
+        .map((raw, c) => {
+          const cell = normalize(raw);
+
+          if (!cell) {
+            return "";
+          }
+
+          const ref = `${columnLetter(c)}${r + 1}`;
+          const style = STYLE_ID[cell.style ?? "text"];
+
+          if (typeof cell.value === "number" && Number.isFinite(cell.value)) {
+            return `<c r="${ref}" s="${style}"><v>${cell.value}</v></c>`;
+          }
+
+          return `<c r="${ref}" s="${style}" t="inlineStr"><is><t xml:space="preserve">${escapeXml(String(cell.value))}</t></is></c>`;
+        })
+        .join("");
+
+      return `<row r="${r + 1}">${cells}</row>`;
+    })
+    .join("");
+
+  return (
+    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
+    '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">' +
+    '<sheetPr><pageSetUpPr fitToPage="1"/></sheetPr>' +
+    `<dimension ref="A1:${lastRef}"/>` +
+    view +
+    '<sheetFormatPr defaultRowHeight="18"/>' +
+    cols +
+    `<sheetData>${rows}</sheetData>` +
+    '<pageMargins left="0.5" right="0.5" top="0.6" bottom="0.6" header="0.3" footer="0.3"/>' +
+    `<pageSetup paperSize="9" orientation="${sheet.landscape ? "landscape" : "portrait"}" fitToWidth="1" fitToHeight="0"/>` +
+    "</worksheet>"
+  );
+}
+
+function stylesXml(): string {
+  const border =
+    '<border><left style="thin"><color rgb="FFD0D7D3"/></left><right style="thin"><color rgb="FFD0D7D3"/></right><top style="thin"><color rgb="FFD0D7D3"/></top><bottom style="thin"><color rgb="FFD0D7D3"/></bottom><diagonal/></border>';
+
+  return (
+    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
+    '<styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">' +
+    '<fonts count="4">' +
+    `<font><sz val="11"/><name val="${FONT}"/></font>` +
+    `<font><b/><sz val="15"/><color rgb="FF2F6B4F"/><name val="${FONT}"/></font>` +
+    `<font><b/><sz val="11"/><color rgb="FFFFFFFF"/><name val="${FONT}"/></font>` +
+    `<font><b/><sz val="11"/><name val="${FONT}"/></font>` +
+    "</fonts>" +
+    '<fills count="4">' +
+    '<fill><patternFill patternType="none"/></fill>' +
+    '<fill><patternFill patternType="gray125"/></fill>' +
+    '<fill><patternFill patternType="solid"><fgColor rgb="FF2F6B4F"/><bgColor indexed="64"/></patternFill></fill>' +
+    '<fill><patternFill patternType="solid"><fgColor rgb="FFEAF3EE"/><bgColor indexed="64"/></patternFill></fill>' +
+    "</fills>" +
+    `<borders count="2"><border><left/><right/><top/><bottom/><diagonal/></border>${border}</borders>` +
+    '<cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs>' +
+    '<cellXfs count="5">' +
+    '<xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0" applyFont="1"><alignment vertical="center" wrapText="1"/></xf>' +
+    '<xf numFmtId="0" fontId="1" fillId="0" borderId="0" xfId="0" applyFont="1"><alignment vertical="center"/></xf>' +
+    '<xf numFmtId="0" fontId="2" fillId="2" borderId="1" xfId="0" applyFont="1" applyFill="1" applyBorder="1" applyAlignment="1"><alignment horizontal="center" vertical="center" wrapText="1"/></xf>' +
+    '<xf numFmtId="0" fontId="3" fillId="3" borderId="1" xfId="0" applyFont="1" applyFill="1" applyBorder="1" applyAlignment="1"><alignment vertical="center" wrapText="1"/></xf>' +
+    '<xf numFmtId="0" fontId="0" fillId="0" borderId="1" xfId="0" applyFont="1" applyBorder="1" applyAlignment="1"><alignment horizontal="center" vertical="center" wrapText="1"/></xf>' +
+    "</cellXfs>" +
+    '<cellStyles count="1"><cellStyle name="Normal" xfId="0" builtinId="0"/></cellStyles>' +
+    "</styleSheet>"
+  );
+}
+
+function contentTypesXml(sheetCount: number): string {
+  const sheets = Array.from(
+    { length: sheetCount },
+    (_, i) =>
+      `<Override PartName="/xl/worksheets/sheet${i + 1}.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>`,
+  ).join("");
+
+  return (
+    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
+    '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">' +
+    '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>' +
+    '<Default Extension="xml" ContentType="application/xml"/>' +
+    '<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>' +
+    '<Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>' +
+    sheets +
+    "</Types>"
+  );
+}
+
+function workbookXml(names: readonly string[]): string {
+  const sheets = names
+    .map(
+      (name, i) =>
+        `<sheet name="${escapeXml(name)}" sheetId="${i + 1}" r:id="rId${i + 1}"/>`,
+    )
+    .join("");
+
+  return (
+    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
+    '<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">' +
+    `<sheets>${sheets}</sheets>` +
+    "</workbook>"
+  );
+}
+
+function workbookRelsXml(sheetCount: number): string {
+  const sheets = Array.from(
+    { length: sheetCount },
+    (_, i) =>
+      `<Relationship Id="rId${i + 1}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet${i + 1}.xml"/>`,
+  ).join("");
+
+  return (
+    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
+    '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">' +
+    sheets +
+    `<Relationship Id="rId${sheetCount + 1}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/>` +
+    "</Relationships>"
+  );
+}
+
+const ROOT_RELS =
+  '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
+  '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">' +
+  '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/>' +
+  "</Relationships>";
+
+function buildZip(sheets: readonly SheetSpec[]): JSZip {
+  const names: string[] = [];
+
+  sheets.forEach((sheet) => names.push(safeSheetName(sheet.name, names)));
+
+  const zip = new JSZip();
+
+  zip.file("[Content_Types].xml", contentTypesXml(sheets.length));
+  zip.file("_rels/.rels", ROOT_RELS);
+  zip.file("xl/workbook.xml", workbookXml(names));
+  zip.file("xl/_rels/workbook.xml.rels", workbookRelsXml(sheets.length));
+  zip.file("xl/styles.xml", stylesXml());
+  sheets.forEach((sheet, i) =>
+    zip.file(`xl/worksheets/sheet${i + 1}.xml`, sheetXml(sheet)),
+  );
+
+  return zip;
+}
+
+export const XLSX_MIME =
+  "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
+
+/** The workbook as a base64 string (what expo-file-system writes to disk). */
+export function buildXlsxBase64(sheets: readonly SheetSpec[]): Promise<string> {
+  return buildZip(sheets).generateAsync({
+    type: "base64",
+    compression: "DEFLATE",
+    mimeType: XLSX_MIME,
+  });
+}
+
+/** The workbook as raw bytes (used by tests and by the web download). */
+export function buildXlsxBytes(
+  sheets: readonly SheetSpec[],
+): Promise<Uint8Array> {
+  return buildZip(sheets).generateAsync({
+    type: "uint8array",
+    compression: "DEFLATE",
+    mimeType: XLSX_MIME,
+  });
+}
diff --git a/src/features/quran/plan/planEngine.ts b/src/features/quran/plan/planEngine.ts
new file mode 100644
index 0000000..0ad92db
--- /dev/null
+++ b/src/features/quran/plan/planEngine.ts
@@ -0,0 +1,371 @@
+import { getSurah } from "@/features/quran/data/surahs";
+import {
+  addDays,
+  diffDays,
+  isValidISO,
+  weekdayOf,
+  type ISODate,
+} from "@/features/quran/plan/calendar";
+
+export interface Segment {
+  surahId: number;
+  from: number;
+  to: number;
+}
+
+export type PlanMode = "perDay" | "targetDate";
+
+export interface PlanConfig {
+  /** Surahs in the order they will be memorized. */
+  surahIds: number[];
+  /** Only used when exactly one surah is selected. `null` = whole surah. */
+  fromAyah: number | null;
+  toAyah: number | null;
+  mode: PlanMode;
+  /** Verses per session (used when `mode` is "perDay"). */
+  perDay: number;
+  /** Memorization days, numbered like `Date#getDay` (0 = Sunday). */
+  weekdays: number[];
+  startDate: ISODate;
+  /** Used when `mode` is "targetDate". */
+  targetDate: ISODate | null;
+  /** Add "review the previous session" to every session. */
+  review: boolean;
+}
+
+export interface PlanSession {
+  index: number;
+  date: ISODate;
+  segments: Segment[];
+  count: number;
+  /** Verses finished after this session. */
+  cumulative: number;
+  review: Segment[];
+}
+
+export type PlanIssue =
+  | "noSurah"
+  | "badRange"
+  | "noWeekday"
+  | "badAmount"
+  | "badDate"
+  | "targetBeforeStart"
+  | "noSessionBeforeTarget"
+  | "tooLong";
+
+export interface PlanSummary {
+  totalAyahs: number;
+  sessionCount: number;
+  maxPerSession: number;
+  minPerSession: number;
+  firstDate: ISODate | null;
+  lastDate: ISODate | null;
+  /** Calendar days from the first to the last session (inclusive). */
+  spanDays: number;
+}
+
+export interface BuiltPlan {
+  issues: PlanIssue[];
+  sessions: PlanSession[];
+  summary: PlanSummary;
+}
+
+export const MAX_PER_DAY = 100;
+export const MAX_SESSIONS = 3000;
+/** Longest stretch of days searched for memorization days. */
+const MAX_SPAN_DAYS = 365 * 15;
+
+export const EMPTY_SUMMARY: PlanSummary = {
+  totalAyahs: 0,
+  sessionCount: 0,
+  maxPerSession: 0,
+  minPerSession: 0,
+  firstDate: null,
+  lastDate: null,
+  spanDays: 0,
+};
+
+export function defaultConfig(startDate: ISODate): PlanConfig {
+  return {
+    surahIds: [],
+    fromAyah: null,
+    toAyah: null,
+    mode: "perDay",
+    perDay: 5,
+    weekdays: [6, 0, 1, 2, 3, 4],
+    startDate,
+    targetDate: null,
+    review: true,
+  };
+}
+
+/** The ranges that make up the plan, in memorization order. */
+export function scopeBlocks(config: PlanConfig): Segment[] {
+  const blocks: Segment[] = [];
+
+  config.surahIds.forEach((surahId) => {
+    const surah = getSurah(surahId);
+
+    if (!surah) {
+      return;
+    }
+
+    const single = config.surahIds.length === 1;
+    const from = single ? (config.fromAyah ?? 1) : 1;
+    const to = single ? (config.toAyah ?? surah.verses) : surah.verses;
+
+    blocks.push({ surahId, from, to });
+  });
+
+  return blocks;
+}
+
+export function countAyahs(segments: readonly Segment[]): number {
+  return segments.reduce((sum, item) => sum + (item.to - item.from + 1), 0);
+}
+
+function validateRange(config: PlanConfig): boolean {
+  if (config.surahIds.length !== 1) {
+    return true;
+  }
+
+  const surah = getSurah(config.surahIds[0]!);
+
+  if (!surah) {
+    return false;
+  }
+
+  const from = config.fromAyah ?? 1;
+  const to = config.toAyah ?? surah.verses;
+
+  return from >= 1 && to <= surah.verses && from <= to;
+}
+
+/** Cuts `amounts[i]` verses per session out of the ordered blocks. */
+function slice(blocks: readonly Segment[], amounts: readonly number[]) {
+  const result: Segment[][] = [];
+  let blockIndex = 0;
+  let cursor = blocks[0]?.from ?? 1;
+
+  amounts.forEach((amount) => {
+    const segments: Segment[] = [];
+    let left = amount;
+
+    while (left > 0 && blockIndex < blocks.length) {
+      const block = blocks[blockIndex]!;
+      const take = Math.min(left, block.to - cursor + 1);
+
+      segments.push({
+        surahId: block.surahId,
+        from: cursor,
+        to: cursor + take - 1,
+      });
+
+      left -= take;
+      cursor += take;
+
+      if (cursor > block.to) {
+        blockIndex += 1;
+        cursor = blocks[blockIndex]?.from ?? 1;
+      }
+    }
+
+    result.push(segments);
+  });
+
+  return result;
+}
+
+/** Memorization days from `start` on, optionally up to `until` (inclusive). */
+function memorizationDates(
+  start: ISODate,
+  weekdays: readonly number[],
+  limit: number,
+  until: ISODate | null,
+): ISODate[] {
+  const allowed = new Set(weekdays);
+  const dates: ISODate[] = [];
+  const lastOffset = until ? diffDays(start, until) : MAX_SPAN_DAYS;
+
+  for (
+    let offset = 0;
+    offset <= Math.min(lastOffset, MAX_SPAN_DAYS) && dates.length < limit;
+    offset += 1
+  ) {
+    const date = addDays(start, offset);
+
+    if (allowed.has(weekdayOf(date))) {
+      dates.push(date);
+    }
+  }
+
+  return dates;
+}
+
+function summarize(sessions: readonly PlanSession[]): PlanSummary {
+  if (sessions.length === 0) {
+    return EMPTY_SUMMARY;
+  }
+
+  const counts = sessions.map((session) => session.count);
+  const firstDate = sessions[0]!.date;
+  const lastDate = sessions[sessions.length - 1]!.date;
+
+  return {
+    totalAyahs: counts.reduce((sum, value) => sum + value, 0),
+    sessionCount: sessions.length,
+    maxPerSession: Math.max(...counts),
+    minPerSession: Math.min(...counts),
+    firstDate,
+    lastDate,
+    spanDays: diffDays(firstDate, lastDate) + 1,
+  };
+}
+
+function fail(issues: PlanIssue[]): BuiltPlan {
+  return { issues, sessions: [], summary: EMPTY_SUMMARY };
+}
+
+/**
+ * Turns a plan configuration into a day-by-day schedule.
+ *
+ * - "perDay": a fixed number of verses per session, the last one may be shorter.
+ * - "targetDate": the verses are spread as evenly as possible over every
+ *   memorization day up to the target date (sessions differ by at most one verse).
+ */
+export function buildPlan(config: PlanConfig): BuiltPlan {
+  const issues: PlanIssue[] = [];
+  const blocks = scopeBlocks(config);
+
+  if (blocks.length === 0) {
+    issues.push("noSurah");
+  } else if (!validateRange(config)) {
+    issues.push("badRange");
+  }
+
+  if (config.weekdays.length === 0) {
+    issues.push("noWeekday");
+  }
+
+  if (!isValidISO(config.startDate)) {
+    issues.push("badDate");
+  }
+
+  if (config.mode === "perDay") {
+    if (
+      !Number.isInteger(config.perDay) ||
+      config.perDay < 1 ||
+      config.perDay > MAX_PER_DAY
+    ) {
+      issues.push("badAmount");
+    }
+  } else if (!config.targetDate || !isValidISO(config.targetDate)) {
+    issues.push("badDate");
+  } else if (
+    isValidISO(config.startDate) &&
+    diffDays(config.startDate, config.targetDate) < 0
+  ) {
+    issues.push("targetBeforeStart");
+  }
+
+  if (issues.length > 0) {
+    return fail(issues);
+  }
+
+  const total = countAyahs(blocks);
+  let dates: ISODate[];
+  let amounts: number[];
+
+  if (config.mode === "perDay") {
+    const sessions = Math.ceil(total / config.perDay);
+
+    if (sessions > MAX_SESSIONS) {
+      return fail(["tooLong"]);
+    }
+
+    dates = memorizationDates(
+      config.startDate,
+      config.weekdays,
+      sessions,
+      null,
+    );
+    amounts = dates.map((_, i) =>
+      Math.min(config.perDay, total - i * config.perDay),
+    );
+  } else {
+    const available = memorizationDates(
+      config.startDate,
+      config.weekdays,
+      MAX_SESSIONS,
+      config.targetDate,
+    );
+
+    if (available.length === 0) {
+      return fail(["noSessionBeforeTarget"]);
+    }
+
+    const used = Math.min(available.length, total);
+    const base = Math.floor(total / used);
+    const extra = total % used;
+
+    dates = available.slice(0, used);
+    amounts = dates.map((_, i) => base + (i < extra ? 1 : 0));
+  }
+
+  if (dates.length < amounts.length || dates.length > MAX_SESSIONS) {
+    return fail(["tooLong"]);
+  }
+
+  const parts = slice(blocks, amounts);
+  let cumulative = 0;
+  const sessions: PlanSession[] = dates.map((date, index) => {
+    const segments = parts[index] ?? [];
+    const count = countAyahs(segments);
+
+    cumulative += count;
+
+    return {
+      index,
+      date,
+      segments,
+      count,
+      cumulative,
+      review: config.review && index > 0 ? (parts[index - 1] ?? []) : [],
+    };
+  });
+
+  return { issues: [], sessions, summary: summarize(sessions) };
+}
+
+/** Index of the session on `date`, or -1. */
+export function sessionOn(
+  sessions: readonly PlanSession[],
+  date: ISODate,
+): number {
+  return sessions.findIndex((session) => session.date === date);
+}
+
+/** First session on or after `date`, or -1 when the plan is over. */
+export function nextSessionFrom(
+  sessions: readonly PlanSession[],
+  date: ISODate,
+): number {
+  return sessions.findIndex((session) => session.date >= date);
+}
+
+export function formatSegments(
+  segments: readonly Segment[],
+  numberFormat: (value: number) => string,
+  surahName: (surahId: number) => string,
+): string {
+  return segments
+    .map((segment) => {
+      const range =
+        segment.from === segment.to
+          ? numberFormat(segment.from)
+          : `${numberFormat(segment.from)}–${numberFormat(segment.to)}`;
+
+      return `${surahName(segment.surahId)} ${range}`;
+    })
+    .join(" · ");
+}
