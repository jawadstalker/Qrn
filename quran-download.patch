@@ -0,0 +1,142 @@
+import { Platform } from 'react-native';
+import * as FileSystem from 'expo-file-system';
+import * as IntentLauncher from 'expo-intent-launcher';
+
+/**
+ * Modules that ship as separate Android apps and are downloaded from
+ * our own host instead of GitHub.
+ *
+ * The APK files live in `public_html/apps/` on iliyacore.ir.
+ * The package name must match the `android.package` of the module app,
+ * and it must also be declared in plugins/withExternalGameQuery.js
+ * (otherwise Android 11+ hides the app and "is it installed?" is always
+ * answered with "no").
+ */
+export const HOSTED_APPS = {
+  quran: {
+    packageName: 'com.deathstalker_owen.qurangarden',
+    apkUrl: 'https://iliyacore.ir/apps/quran-garden.apk',
+    fileName: 'quran-garden.apk',
+  },
+} as const;
+
+export type HostedAppId = keyof typeof HOSTED_APPS;
+
+export interface HostedApp {
+  packageName: string;
+  apkUrl: string;
+  fileName: string;
+}
+
+const APK_MIME_TYPE = 'application/vnd.android.package-archive';
+
+// A real APK is a ZIP file: it starts with the bytes "PK\x03\x04",
+// which is "UEsD" in base64. This catches the case where the host
+// answers 200 but sends an HTML error page instead of the file.
+const ZIP_MAGIC_BASE64_PREFIX = 'UEsD';
+
+// Anything smaller than this cannot be a real Expo/React Native APK.
+const MIN_APK_BYTES = 1_000_000;
+
+/**
+ * Opens an already installed app by package name.
+ * Resolves to false when the app is not installed (or not visible
+ * to this app because it is missing from <queries>).
+ */
+export async function openInstalledApp(
+  packageName: string
+): Promise<boolean> {
+  if (Platform.OS !== 'android') {
+    return false;
+  }
+
+  try {
+    // Must be awaited: openApplication returns a Promise, so without
+    // `await` a missing app would never reach the catch block.
+    await IntentLauncher.openApplication(packageName);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Downloads the APK into the cache directory and returns its file URI.
+ * `onProgress` receives a number between 0 and 1.
+ */
+export async function downloadApk(
+  app: HostedApp,
+  onProgress?: (progress: number) => void
+): Promise<string> {
+  const cacheDir = FileSystem.cacheDirectory;
+
+  if (!cacheDir) {
+    throw new Error('Cache directory is not available');
+  }
+
+  const target = `${cacheDir}${app.fileName}`;
+
+  // Remove any half-downloaded or older copy first.
+  await FileSystem.deleteAsync(target, { idempotent: true });
+
+  const task = FileSystem.createDownloadResumable(
+    app.apkUrl,
+    target,
+    {},
+    (event) => {
+      if (event.totalBytesExpectedToWrite > 0) {
+        onProgress?.(
+          event.totalBytesWritten / event.totalBytesExpectedToWrite
+        );
+      }
+    }
+  );
+
+  const result = await task.downloadAsync();
+
+  if (!result || result.status !== 200) {
+    await FileSystem.deleteAsync(target, { idempotent: true });
+    throw new Error(`Download failed (HTTP ${result?.status ?? 'none'})`);
+  }
+
+  const info = await FileSystem.getInfoAsync(result.uri);
+
+  if (!info.exists || info.size < MIN_APK_BYTES) {
+    await FileSystem.deleteAsync(target, { idempotent: true });
+    throw new Error('Downloaded file is too small to be an APK');
+  }
+
+  const header = await FileSystem.readAsStringAsync(result.uri, {
+    encoding: FileSystem.EncodingType.Base64,
+    position: 0,
+    length: 4,
+  });
+
+  if (!header.startsWith(ZIP_MAGIC_BASE64_PREFIX)) {
+    await FileSystem.deleteAsync(target, { idempotent: true });
+    throw new Error('Downloaded file is not an APK');
+  }
+
+  onProgress?.(1);
+
+  return result.uri;
+}
+
+/**
+ * Hands the downloaded APK to Android's package installer.
+ * The first time, Android asks the user to allow "install unknown apps"
+ * for Neurolia (needs REQUEST_INSTALL_PACKAGES in app.json).
+ */
+export async function installApk(fileUri: string): Promise<void> {
+  const contentUri = await FileSystem.getContentUriAsync(fileUri);
+
+  await IntentLauncher.startActivityAsync(
+    'android.intent.action.VIEW',
+    {
+      data: contentUri,
+      // FLAG_GRANT_READ_URI_PERMISSION
+      flags: 1,
+      type: APK_MIME_TYPE,
+    }
+  );
+}
