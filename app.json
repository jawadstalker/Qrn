{
  "expo": {
    "name": "Quran Garden",
    "slug": "quran-garden",
    "scheme": "qurangarden",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C1A16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deathstalker-owen.qurangarden"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2F6B4F"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.deathstalker_owen.qurangarden"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "27.3.13750724"
          }
        }
      ],
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {}
    }
  }
}
